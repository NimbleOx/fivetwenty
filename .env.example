# OANDA API Configuration for Development and Testing
# Copy this file to .env and fill in your credentials

# Required: Your OANDA API token
# Get your token from: https://www.oanda.com/account/tpa/personal_token
FIVETWENTY_OANDA_TOKEN=your-oanda-api-token-here

# Required: Your OANDA account ID
# Find this in your OANDA account dashboard
FIVETWENTY_OANDA_ACCOUNT=your-account-id-here

# Optional: Environment (practice or live)
# Default: practice
# WARNING: Use 'live' only for real trading with real money
FIVETWENTY_OANDA_ENVIRONMENT=practice

# Note: Account alias is automatically generated from prefix
# (default account uses "default" as alias)

# Multiple Account Support (Optional)
# You can configure multiple accounts with different prefixes:
# MOMENTUM_FIVETWENTY_OANDA_TOKEN=momentum-strategy-token
# MOMENTUM_FIVETWENTY_OANDA_ACCOUNT=momentum-account-id
# MOMENTUM_FIVETWENTY_OANDA_ENVIRONMENT=practice
# (alias will be "MOMENTUM")

# GRID_FIVETWENTY_OANDA_TOKEN=grid-strategy-token
# GRID_FIVETWENTY_OANDA_ACCOUNT=grid-account-id
# GRID_FIVETWENTY_OANDA_ENVIRONMENT=practice
# (alias will be "GRID")
