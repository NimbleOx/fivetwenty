# OANDA API Configuration for Development and Testing
# Copy this file to .env and fill in your credentials

# Required: Your OANDA API token
# Get your token from: https://www.oanda.com/account/tpa/personal_token
FIVETWENTY_OANDA_TOKEN=your-oanda-api-token-here

# Required: Your OANDA account ID
# Find this in your OANDA account dashboard
FIVETWENTY_OANDA_ACCOUNT=your-account-id-here

# Optional: Environment (practice or live)
# Default: practice
# WARNING: Use 'live' only for real trading with real money
FIVETWENTY_OANDA_ENVIRONMENT=practice

# Optional: Account alias for display purposes
FIVETWENTY_OANDA_ACCOUNT_ALIAS=my_practice_account

# Integration Test Configuration
# Set to 1 to skip integration tests during normal test runs
# SKIP_INTEGRATION=1

# Multiple Account Support (Optional)
# You can configure multiple accounts with different prefixes:
# FIVETWENTY_MOMENTUM_OANDA_TOKEN=momentum-strategy-token
# FIVETWENTY_MOMENTUM_OANDA_ACCOUNT=momentum-account-id
# FIVETWENTY_MOMENTUM_OANDA_ENVIRONMENT=practice
# FIVETWENTY_MOMENTUM_ACCOUNT_ALIAS=momentum_strategy

# FIVETWENTY_GRID_OANDA_TOKEN=grid-strategy-token
# FIVETWENTY_GRID_OANDA_ACCOUNT=grid-account-id
# FIVETWENTY_GRID_OANDA_ENVIRONMENT=practice
# FIVETWENTY_GRID_ACCOUNT_ALIAS=grid_strategy