{
  // Python interpreter
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",

  // === Pylance: semantic highlighting only (no overlapping diagnostics) ===
  "python.languageServer": "Pylance",
  "editor.semanticHighlighting.enabled": true,
  "python.analysis.typeCheckingMode": "off", // mypy is the source of truth
  "python.analysis.diagnosticMode": "openFilesOnly", // avoid scanning entire workspace
  "python.analysis.diagnosticSeverityOverrides": {
    // Silence checks handled by ruff/mypy to prevent duplicates
    "reportUnusedImport": "none",
    "reportUnusedVariable": "none",
    "reportUndefinedVariable": "none",
    "reportMissingImports": "none",
    "reportMissingModuleSource": "none",
    "reportMissingTypeStubs": "none",
    "reportGeneralTypeIssues": "none",
    "reportOptionalMemberAccess": "none",
    "reportOptionalSubscript": "none",
    "reportUnknownVariableType": "none",
    "reportUnknownMemberType": "none",
    "reportPrivateUsage": "none",
    "reportWildcardImportFromLibrary": "none"
  },

  // Ruff configuration
  "ruff.enable": true,
  "ruff.path": ["${workspaceFolder}/.venv/bin/ruff"],


  // Use Ruff as the formatter & fixer
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },

  // TOML formatting with Ruff
  "[toml]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true
  },

  // File associations for TOML
  "files.associations": {
    "*.toml": "toml",
    "pyproject.toml": "toml",
    "Cargo.toml": "toml",
    "Pipfile": "toml"
  },

  // Type checking with mypy
  "mypy.dmypyExecutable": "${workspaceFolder}/.venv/bin/dmypy",
  "mypy.runUsingActiveInterpreter": false,
  "mypy.configFile": "pyproject.toml",
  "mypy.targets": ["."],

  // Editor settings
  "editor.rulers": [], // No line length rulers
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,

  // Exclude directories
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.mypy_cache": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/dist": true,
    "**/build": true,
    "**/*.egg-info": true
  },

  // Test configuration
  "python.testing.pytestEnabled": true,
  "python.testing.pytestPath": "${workspaceFolder}/.venv/bin/pytest",
  "python.testing.pytestArgs": ["tests"],

  // YAML configuration
  "[yaml]": {
    "editor.formatOnSave": false, // Prevent conflicts with yamllint
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.detectIndentation": false
  },

  // YAML extension settings (Red Hat YAML extension)
  "yaml.validate": false, // Disable validation to prevent Python tag errors
  "yaml.format.enable": true,
  "yaml.format.singleQuote": false,
  "yaml.format.bracketSpacing": true,
  "yaml.completion": true,
  "yaml.hover": true,
  "yaml.schemas": {},

  // Custom tags for PyYAML - comprehensive list
  "yaml.customTags": [
    "!!python/name:material.extensions.emoji.twemoji",
    "!!python/name:material.extensions.emoji.to_svg",
    "!!python/name:pymdownx.superfences.fence_code_format",
    "!!python/object:material.extensions.emoji.twemoji",
    "!!python/object:material.extensions.emoji.to_svg",
    "!!python/object:pymdownx.superfences.fence_code_format"
  ],

  // Disable specific validation for mkdocs.yml to prevent conflicts
  "yaml.disableAdditionalProperties": true
}
